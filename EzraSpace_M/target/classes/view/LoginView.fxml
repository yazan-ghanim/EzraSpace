<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:id="rootPane"
            fx:controller="controller.LoginController">
    <children>
        <ImageView fx:id="backgroundImage"
                   preserveRatio="false"
                   AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
                   AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0">
            <image>
                <Image url="@../images/background.jpeg"/>
            </image>
        </ImageView>

        <VBox spacing="20"
              layoutX="350" layoutY="200"
              style="-fx-background-color: rgba(255,255,255,0.7); -fx-padding: 40;">
            <ChoiceBox fx:id="userTypeChoiceBox" prefWidth="150"/>
            <Label text="Welcome to Ezra Space" style="-fx-font-size: 20px;"/>
            <TextField fx:id="usernameField" promptText="Username"/>
            <PasswordField fx:id="passwordField" promptText="Password"/>
            <HBox spacing="10">
                <Button text="Sign In" onAction="#handleSignIn"/>
                <Button text="Sign Up" onAction="#handleSignUp"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
